{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://vidland-backend.onrender.com/api/:path*"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    }
  ]
}